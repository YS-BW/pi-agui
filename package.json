{
	"name": "pi-agui",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "把 pi 的 AgentSession 包成 AG-UI 服务：SSE 事件流、工具调用、人工介入、断线回放",
	"scripts": {
		"server": "node examples/serve.ts",
		"dev:web": "npm --prefix examples/copilotkit/web run dev",
		"build:web": "npm --prefix examples/copilotkit/web run build",
		"typecheck:web": "npm --prefix examples/copilotkit/web run typecheck",
		"test": "node --test test/*.test.ts",
		"typecheck": "tsc -p tsconfig.json",
		"smoke": "node examples/smoke.ts",
		"smoke:client": "node examples/client-smoke.ts",
		"smoke:approval": "node examples/approval-smoke.ts",
		"smoke:capabilities": "node examples/capabilities-smoke.ts",
		"smoke:activity": "node examples/activity-smoke.ts",
		"test:copilotkit": "npm --prefix examples/copilotkit test"
	},
	"engines": {
		"node": ">=22.19"
	},
	"dependencies": {
		"@ag-ui/client": "1.0.3",
		"@ag-ui/core": "1.0.3",
		"@ag-ui/encoder": "1.0.3",
		"@earendil-works/pi-coding-agent": "1.3.0",
		"zod": "3.25.76"
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "1.3.0",
		"@types/node": "^22.19.1",
		"typescript": "^5.9.3"
	},
	"keywords": [
		"pi",
		"ag-ui",
		"agent",
		"sse",
		"coding-agent"
	],
	"license": "MIT"
}
